{
  "name": "native-standalone-example",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Standalone Native Harness host example. Dependencies are provided by the fresh-install verifier (the local @kingsoftcloud/agentkit-harness-core and @kingsoftcloud/agentkit-harness-node tarballs); this package.json declares none so the example cannot accidentally import Studio/src.",
  "scripts": {
    "happy": "node host.mjs --db ./runs/happy.sqlite --workspace ./ws --scenario happy --evidence ./evidence-happy.json",
    "cancel": "FAKE_SCENARIO=cancel node host.mjs --db ./runs/cancel.sqlite --workspace ./ws --scenario cancel --cancel-after 200 --evidence ./evidence-cancel.json",
    "deny": "FAKE_SCENARIO=deny node host.mjs --db ./runs/deny.sqlite --workspace ./ws --scenario deny --permissions workspace:read --evidence ./evidence-deny.json",
    "budget": "FAKE_SCENARIO=budget node host.mjs --db ./runs/budget.sqlite --workspace ./ws --scenario budget --evidence ./evidence-budget.json",
    "restart": "FAKE_SCENARIO=restart NATIVE_CRASH_AFTER_WRITE=1 node host.mjs --db ./runs/restart.sqlite --workspace ./ws --scenario restart --crash-after-write --evidence ./evidence-restart-a.json"
  }
}
